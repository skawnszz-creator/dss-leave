# ------------------------------------------------------------------
# DSS 휴가 관리 — 환경변수 예시
#
# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채운다.
# .env.local 은 git 에 올리지 않는다. 비밀번호를 여기에 적지 않는다.
# ------------------------------------------------------------------

# 이 사이트 전용 PostgreSQL DB (계측기 DB 와 따로)
DATABASE_URL=postgres://dss_leave:여기에_비밀번호@localhost:5432/dss_leave

# 이 사이트가 쓸 포트 (A/S 3000 · dss-auth 3100 · 계측기 3200 과 겹치지 않게)
PORT=3300

# 세션 쿠키에 secure 를 붙일지.
# 사내망 HTTP 단계에서 true 로 켜면 쿠키가 저장되지 않아 로그인이 조용히 실패한다.
# HTTPS 를 붙인 뒤에 true 로 바꾼다.
SESSION_COOKIE_SECURE=false

# 세션 수명(시간). dss-auth SSO 세션의 절대 만료 12시간을 넘기지 않는다.
SESSION_HOURS=12

# ------------------------------------------------------------------
# 임시 로그인 — dss-auth OIDC 연결 시 폐기 대상
# 기본값은 반드시 꺼짐(false). 개발 중에만 true 로 둔다.
# ------------------------------------------------------------------
DEV_FAKE_LOGIN_ENABLED=false

# ------------------------------------------------------------------
# dss-auth 통합 로그인 (포털 OIDC 엔드포인트 완성 후 채운다)
# client_secret 에 NEXT_PUBLIC_ 접두사를 붙이지 않는다 — 브라우저로 새어나간다.
# ------------------------------------------------------------------
# OIDC_ISSUER=
# OIDC_CLIENT_ID=dss-leave
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3300/api/auth/callback
